        "/{chain}/{dex}/pools": {
            "get": {
                "summary": "List all pools for a specific DEX",
                "description": "Returns a list of all liquidity pools for the specified DEX, including token pairs, fee tiers, and creation timestamps. Response includes all pools (example shows single pool for brevity). Currently only supports BASE chain, Solana support coming soon.",
                "operationId": "listDexPools",
                "parameters": [
                    {
                        "name": "chain",
                        "in": "path",
                        "description": "Chain identifier (e.g., base, solana)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": ["base", "solana"]
                        }
                    },
                    {
                        "name": "dex",
                        "in": "path",
                        "description": "DEX name (e.g., UniswapV3). Use /dexes endpoint to get valid DEX names.",
                        "required": true,
                        "schema": {
