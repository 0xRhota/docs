        "/{chain}/dexes": {
            "get": {
                "summary": "List DEXes on a chain",
                "description": "Returns a list of all DEXes available on the specified chain, including their factory addresses and names. Currently only supports BASE chain, Solana support coming soon.",
                "operationId": "listDexes",
                "parameters": [
                    {
                        "name": "chain",
                        "in": "path",
                        "description": "Chain identifier (e.g., base, solana)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": ["base", "solana"]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "example": [
                                    {
                                        "columns": [
                                            {
                                                "name": "address",
                                                "type": "FixedString(44)"
                                            },
                                            {
                                                "name": "name",
                                                "type": "FixedString(20)"
                                            }
                                        ],
                                        "data": [
